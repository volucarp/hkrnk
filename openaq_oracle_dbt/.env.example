OPENAQ_API_KEY=replace_with_your_openaq_api_key

ORA_PYTHON_DRIVER_TYPE=thin
# Directory containing the Autonomous Database wallet files.
# TNS_ADMIN=/Users/your-user/.oracle/openaq_wallet
DBT_ORACLE_USER=OPENAQ_USER
DBT_ORACLE_PASSWORD=replace_with_oracle_password
DBT_ORACLE_SCHEMA=OPENAQ_USER
DBT_ORACLE_RAW_SCHEMA=OPENAQ_USER
DBT_ORACLE_DATABASE=replace_with_database_name
DBT_ORACLE_TNS_NAME=replace_with_tns_alias

# Alternative for the Python raw loader if you prefer an Easy Connect string.
# ORACLE_DSN=host.example.com:1522/service_name
